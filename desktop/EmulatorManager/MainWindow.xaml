<Window x:Class="EmulatorManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emulator Manager" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="#0F1420" Foreground="#E8EDF7" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A3550"/><Setter Property="Foreground" Value="#E8EDF7"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5B8CFF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1322"/><Setter Property="Foreground" Value="#E8EDF7"/>
      <Setter Property="BorderBrush" Value="#2A3550"/><Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0D1322"/><Setter Property="Foreground" Value="#E8EDF7"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#161D2E" Margin="0,0,0,0">
      <TextBlock Text="▣ Emulator Manager" FontSize="17" FontWeight="Bold" Margin="14,10,0,10" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Text="starting…" Foreground="#8B96B0" Margin="16,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Background="#161D2E" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,4">
          <Button x:Name="RefreshBtn" Content="↻ Refresh" Click="RefreshBtn_Click"/>
          <Button x:Name="StartBtn" Content="▶ Start" Click="StartBtn_Click"/>
          <Button x:Name="StopBtn" Content="■ Stop" Click="StopBtn_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,10,4">
          <ComboBox x:Name="BootSnap" Width="150" ToolTip="Snapshot to boot (empty = default)"/>
          <ComboBox x:Name="BootGpu" Width="130" ToolTip="GPU mode">
            <ComboBoxItem Content="host" IsSelected="True"/>
            <ComboBoxItem Content="swiftshader_indirect"/>
            <ComboBoxItem Content="auto"/>
          </ComboBox>
          <CheckBox x:Name="BootWindow" Content="Show window" IsChecked="True" VerticalAlignment="Center"
                    Foreground="#8B96B0" ToolTip="Real-time emulator window (smoother than polled preview)"/>
        </StackPanel>
        <ListBox x:Name="AvdList" Background="Transparent" BorderThickness="0" Foreground="#E8EDF7"
                 SelectionChanged="AvdList_SelectionChanged" Margin="6,0,6,10">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#1B2338" CornerRadius="10" Padding="10" Margin="2,4,2,4" BorderBrush="#2A3550" BorderThickness="1">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Ellipse.Style><Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#555"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Running}" Value="True">
                          <Setter Property="Fill" Value="#34D17B"/>
                        </DataTrigger></Style.Triggers>
                      </Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Target}" Foreground="#8B96B0" FontSize="12" Margin="18,2,0,0"/>
                  <TextBlock Foreground="#8B96B0" FontSize="12" Margin="18,0,0,0">
                    <Run Text="{Binding Ram_mb, Mode=OneWay}"/><Run Text=" MB · "/>
                    <Run Text="{Binding Cpus, Mode=OneWay}"/><Run Text=" cpu · "/>
                    <Run Text="{Binding Serial, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <TabControl Grid.Column="1" Background="#0F1420" BorderThickness="0" Margin="8">
        <TabItem Header="Display">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
              <Button Content="◀ Back" Click="BackBtn_Click"/>
              <Button Content="● Home" Click="HomeBtn_Click"/>
              <Button Content="■ Recent" Click="RecentBtn_Click"/>
              <TextBox x:Name="TypeBox" Width="220" Margin="8,0,6,6" VerticalContentAlignment="Center"
                       ToolTip="Type here, Enter sends text"/>
              <Button Content="Send" Click="SendText_Click"/>
              <Button Content="Screenshot" Click="ShotBtn_Click"/>
              <Button Content="Focus window" Click="FocusBtn_Click"/>
            </StackPanel>
            <Border Background="Black" CornerRadius="10" BorderBrush="#2A3550" BorderThickness="1">
              <Image x:Name="Screen" Stretch="Uniform"
                     MouseLeftButtonDown="Screen_MouseDown" MouseLeftButtonUp="Screen_MouseUp"
                     MouseMove="Screen_MouseMove" Focusable="True"/>
            </Border>
          </DockPanel>
        </TabItem>
        <TabItem Header="Snapshots">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <TextBox x:Name="SnapName" Width="220" Margin="0,0,6,6" VerticalContentAlignment="Center"/>
              <Button Content="Save snapshot" Click="SaveSnap_Click"/>
              <Button Content="Reload" Click="SnapReload_Click"/>
            </StackPanel>
            <ListBox x:Name="SnapList" Background="#161D2E" Foreground="#E8EDF7" BorderThickness="0"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="Settings">
          <StackPanel Margin="4">
            <TextBlock Foreground="#8B96B0" Margin="0,0,0,8">Applied to config.ini. Device must be stopped.</TextBlock>
            <WrapPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock Text="RAM MB"/><TextBox x:Name="CfgRam" Width="120"/></StackPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock Text="CPUs"/><TextBox x:Name="CfgCpu" Width="120"/></StackPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock Text="Width"/><TextBox x:Name="CfgW" Width="120"/></StackPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock Text="Height"/><TextBox x:Name="CfgH" Width="120"/></StackPanel>
              <StackPanel Margin="0,0,16,8"><TextBlock Text="Density"/><TextBox x:Name="CfgD" Width="120"/></StackPanel>
            </WrapPanel>
            <StackPanel Orientation="Horizontal"><Button Content="Apply" Click="ApplyCfg_Click"/><Button Content="Install APK…" Click="InstallBtn_Click"/></StackPanel>
            <TextBlock x:Name="CfgMsg" Foreground="#8B96B0" Margin="0,8,0,0"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Log">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Top" Content="Reload log" Click="LogReload_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBox x:Name="LogBox" Background="#080C16" Foreground="#9FB3D9" FontFamily="Consolas"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
